<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-independent checks for the Core folder; runs on Linux or Windows with "dotnet run". -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\STGPhantomVPN\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
