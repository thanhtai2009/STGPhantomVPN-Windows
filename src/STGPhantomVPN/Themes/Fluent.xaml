<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:views="clr-namespace:STGPhantomVPN.Views">
    <!-- WinUI 3 / Windows 11 Fluent look for WPF on .NET Framework 4.8 (Windows 7 SP1 to 11).
         Colours come from Colors.Light.xaml / Colors.Dark.xaml (ThemeService swaps them), always via DynamicResource.
         Corner radii follow WinUI: 4 for controls, 8 for cards, flyouts and dialogs. -->

    <!-- Typography: Segoe UI Variable on Windows 11, Segoe UI elsewhere (WPF falls back along the list). -->
    <FontFamily x:Key="Fluent.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Fluent.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <sys:Double x:Key="Fluent.CaptionSize">12</sys:Double>
    <sys:Double x:Key="Fluent.BodySize">14</sys:Double>
    <sys:Double x:Key="Fluent.SubtitleSize">20</sys:Double>
    <sys:Double x:Key="Fluent.TitleSize">28</sys:Double>
    <CornerRadius x:Key="Fluent.ControlRadius">4</CornerRadius>
    <CornerRadius x:Key="Fluent.OverlayRadius">8</CornerRadius>

    <Style x:Key="Fluent.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Fluent.TextSecondary}" />
    </Style>
    <Style x:Key="Fluent.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Fluent.BodyStrong" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Fluent.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fluent.DisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Fluent.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fluent.DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Secondary text (descriptions, hints). -->
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Fluent.TextSecondary}" />
    </Style>
    <!-- Section heading above a group of SettingsCards. -->
    <Style x:Key="Fluent.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Fluent.BodyStrong}">
        <Setter Property="Margin" Value="1,14,0,6" />
    </Style>

    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.AccentText}" />
        <Setter Property="TextDecorations" Value="None" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Cards: layer fill, 1 px stroke, 8 px corners. -->
    <Style x:Key="SectionCard" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Fluent.CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fluent.CardStroke}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Buttons -->
    <ControlTemplate x:Key="Fluent.ButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"
                CornerRadius="{Binding (views:FluentAssist.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
            <StackPanel Margin="{TemplateBinding Padding}" Orientation="Horizontal"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <views:ProgressRing x:Name="Ring" Width="16" Height="16" Margin="0,0,8,0" Visibility="Collapsed" IsActive="False" VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}" />
                <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="views:FluentAssist.IsBusy" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                <Setter TargetName="Ring" Property="IsActive" Value="True" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- Stretching variant for card-like buttons (server rows): the content fills the width. -->
    <ControlTemplate x:Key="Fluent.StretchButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"
                CornerRadius="{Binding (views:FluentAssist.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
    </ControlTemplate>

    <Style x:Key="Fluent.Button" TargetType="ButtonBase">
        <Setter Property="Template" Value="{StaticResource Fluent.ButtonTemplate}" />
        <Setter Property="Background" Value="{DynamicResource Fluent.ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fluent.ControlStrokeStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Fluent.Text}" />
        <Setter Property="Padding" Value="11,5,11,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Fluent.FocusVisual}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fluent.ControlFillHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fluent.ControlFillPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Fluent.TextSecondary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Fluent.TextDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Fluent.ControlStroke}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Fluent.Button}" />

    <Style x:Key="Fluent.AccentButton" TargetType="ButtonBase" BasedOn="{StaticResource Fluent.Button}">
        <Setter Property="Background" Value="{DynamicResource Fluent.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fluent.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Fluent.TextOnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fluent.AccentHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Fluent.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fluent.AccentPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Fluent.AccentPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Fluent.TextOnAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Fluent.AccentDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Fluent.AccentDisabled}" />
                <Setter Property="Foreground" Value="{DynamicResource Fluent.TextOnAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Transparent until hovered (HyperlinkButton / AppBarButton style). -->
    <Style x:Key="Fluent.SubtleButton" TargetType="ButtonBase" BasedOn="{StaticResource Fluent.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fluent.SubtleHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fluent.SubtlePressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Fluent.IconButton" TargetType="ButtonBase" BasedOn="{StaticResource Fluent.SubtleButton}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource Fluent.TextSecondary}" />
    </Style>
    <!-- Clickable card (server rows, the Home server selector). -->
    <Style x:Key="Fluent.CardButton" TargetType="ButtonBase" BasedOn="{StaticResource Fluent.Button}">
        <Setter Property="Template" Value="{StaticResource Fluent.StretchButtonTemplate}" />
        <Setter Property="Background" Value="{DynamicResource Fluent.CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fluent.CardStroke}" />
        <Setter Property="views:FluentAssist.CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16,12" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fluent.ControlFillHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fluent.ControlFillPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Fluent.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Fluent.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Fluent.Text}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleSwitch (ToggleButton): 40 x 20 pill, accent when on. -->
    <Style x:Key="Fluent.ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Fluent.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent" Width="40" Height="20">
                        <Border x:Name="Track" CornerRadius="10" BorderThickness="1" SnapsToDevicePixels="True"
                                Background="{DynamicResource Fluent.SubtleHover}" BorderBrush="{DynamicResource Fluent.ControlStrongStroke}" />
                        <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Fill="{DynamicResource Fluent.TextSecondary}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="14" />
                            <Setter TargetName="Knob" Property="Height" Value="14" />
                            <Setter TargetName="Knob" Property="Margin" Value="3,0" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Fluent.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Fluent.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Fluent.ToggleKnobOn}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Choice pill (RadioButton): segmented selector for theme, language and sort order. -->
    <Style x:Key="Fluent.Choice" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Padding" Value="12,5,12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource Fluent.Text}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Fluent.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" SnapsToDevicePixels="True"
                            Background="{DynamicResource Fluent.ControlFill}" BorderBrush="{DynamicResource Fluent.ControlStrokeStrong}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fluent.ControlFillHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fluent.AccentSubtle}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fluent.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Fluent.AccentText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox: input fill, bottom stroke that turns into a 2 px accent line on focus, placeholder. -->
    <Style x:Key="Fluent.TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Fluent.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Fluent.Accent}" />
        <Setter Property="Padding" Value="10,5,10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" SnapsToDevicePixels="True"
                                Background="{DynamicResource Fluent.ControlFill}" BorderBrush="{DynamicResource Fluent.ControlStroke}" />
                        <Border x:Name="Underline" CornerRadius="0,0,4,4" BorderThickness="0,0,0,1" SnapsToDevicePixels="True"
                                BorderBrush="{DynamicResource Fluent.ControlStrongStroke}" Opacity="0.6" />
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Tag}" VerticalAlignment="Center" />
                            <Grid>
                                <TextBlock x:Name="Placeholder" Margin="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"
                                           Foreground="{DynamicResource Fluent.TextSecondary}" TextTrimming="CharacterEllipsis"
                                           Text="{TemplateBinding views:FluentAssist.Placeholder}" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fluent.ControlFillHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fluent.ControlFillInput}" />
                            <Setter TargetName="Underline" Property="BorderThickness" Value="0,0,0,2" />
                            <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Fluent.Accent}" />
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: button-like closed state with a chevron, rounded flyout list with a selection pill. -->
    <Style x:Key="Fluent.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="Foreground" Value="{DynamicResource Fluent.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="4" Background="Transparent" SnapsToDevicePixels="True" />
                        <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource Fluent.Accent}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fluent.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fluent.SubtleHover}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Fluent.ComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.Text}" />
        <Setter Property="Padding" Value="11,5,36,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MaxDropDownHeight" Value="360" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Fluent.ComboBoxItem}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Fluent.FocusVisual}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" SnapsToDevicePixels="True"
                                            Background="{DynamicResource Fluent.ControlFill}" BorderBrush="{DynamicResource Fluent.ControlStrokeStrong}">
                                        <views:Glyph Kind="ChevronDown" Width="12" Height="12" StrokeWeight="2.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                                     Foreground="{DynamicResource Fluent.TextSecondary}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fluent.ControlFillHover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fluent.ControlFillPressed}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="2" HorizontalOffset="-8"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Margin="8,0,8,16" Padding="0,3" CornerRadius="8" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{DynamicResource Fluent.Flyout}" BorderBrush="{DynamicResource Fluent.FlyoutStroke}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.2" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Indeterminate ProgressBar: a short accent bar running along a hairline track. -->
    <Style x:Key="Fluent.ProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource Fluent.ControlStrongStroke}" Opacity="0.5" />
                        <Border x:Name="Bar" Width="96" HorizontalAlignment="Left" CornerRadius="1.5" Background="{DynamicResource Fluent.Accent}">
                            <Border.RenderTransform>
                                <TranslateTransform X="-96" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     From="-96" To="560" Duration="0:0:1.6">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin overlay-style scroll bars: a 3 px rounded thumb that widens on hover, no arrows. -->
    <Style x:Key="Fluent.ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="3" Background="{DynamicResource Fluent.ScrollThumb}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Width="4" HorizontalAlignment="Center">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Fluent.ScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Track" Property="Width" Value="6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" Height="4" VerticalAlignment="Center">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Fluent.ScrollThumbStyle}" />
                                    </Track.Thumb>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="0,0,8,8" Padding="8,5,8,7" CornerRadius="4" BorderThickness="1" MaxWidth="320"
                            Background="{DynamicResource Fluent.Flyout}" BorderBrush="{DynamicResource Fluent.FlyoutStroke}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.16" />
                        </Border.Effect>
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- InfoBar: severity tint, coloured round icon, bold title then message, optional action on the right. -->
    <Style TargetType="views:InfoBar">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.Text}" />
        <Setter Property="Background" Value="{DynamicResource Fluent.InfoBg}" />
        <Setter Property="Tag" Value="{DynamicResource Fluent.InfoIcon}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:InfoBar">
                    <Border Padding="14,10,12,10" CornerRadius="4" BorderThickness="1" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Fluent.CardStroke}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,12,0" VerticalAlignment="Top">
                                <Ellipse Fill="{TemplateBinding Tag}" />
                                <TextBlock x:Name="Mark" Text="i" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,-1,0,0" Foreground="{DynamicResource Fluent.TextOnAccent}" />
                            </Grid>
                            <ContentPresenter DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13">
                                <Run x:Name="TitleRun" FontWeight="SemiBold" Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                                <Run Text="{Binding Message, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="Mark" Property="Text" Value="✓" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="Mark" Property="Text" Value="!" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="Mark" Property="Text" Value="✕" />
                            <Setter TargetName="Mark" Property="FontSize" Value="9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Severity" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Fluent.SuccessBg}" />
                <Setter Property="Tag" Value="{DynamicResource Fluent.Success}" />
            </Trigger>
            <Trigger Property="Severity" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Fluent.CautionBg}" />
                <Setter Property="Tag" Value="{DynamicResource Fluent.Caution}" />
            </Trigger>
            <Trigger Property="Severity" Value="Error">
                <Setter Property="Background" Value="{DynamicResource Fluent.CriticalBg}" />
                <Setter Property="Tag" Value="{DynamicResource Fluent.Critical}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ContentDialog: smoke over the page, 8 px dialog card with a footer band for the buttons. -->
    <Style TargetType="views:DialogHost">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:DialogHost">
                    <Grid>
                        <ContentPresenter x:Name="Page" />
                        <Grid x:Name="Overlay" Visibility="Collapsed">
                            <Rectangle Fill="{DynamicResource Fluent.Smoke}" />
                            <Border Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource Fluent.Dialog}" BorderBrush="{DynamicResource Fluent.FlyoutStroke}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.26" />
                                </Border.Effect>
                                <ContentPresenter Content="{TemplateBinding DialogContent}" />
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="True">
                            <Setter TargetName="Overlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Page" Property="IsEnabled" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SettingsCard: [icon] header + description ......... control -->
    <Style TargetType="views:SettingsCard">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:SettingsCard">
                    <Border CornerRadius="8" BorderThickness="1" SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}"
                            Background="{DynamicResource Fluent.CardBg}" BorderBrush="{DynamicResource Fluent.CardStroke}">
                        <StackPanel VerticalAlignment="Center">
                            <DockPanel>
                                <views:Glyph x:Name="Icon" DockPanel.Dock="Left" Width="20" Height="20" Margin="2,0,16,0" StrokeWeight="1.6" VerticalAlignment="Center"
                                             Kind="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=Info}"
                                             Foreground="{DynamicResource Fluent.Text}" />
                                <ContentPresenter DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                <StackPanel VerticalAlignment="Center">
                                    <ContentPresenter Content="{TemplateBinding Header}">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="FontSize" Value="14" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                    <ContentPresenter x:Name="Desc" Content="{TemplateBinding Description}">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="Foreground" Value="{DynamicResource Fluent.TextSecondary}" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </StackPanel>
                            </DockPanel>
                            <ContentPresenter x:Name="Foot" Margin="36,10,0,0" Content="{TemplateBinding Footer}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Foot" Property="Margin" Value="0,10,0,0" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="Foot" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SettingsExpander: header row with a chevron, body under a divider. -->
    <Style TargetType="views:SettingsExpander">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:SettingsExpander">
                    <Border CornerRadius="8" BorderThickness="1" SnapsToDevicePixels="True"
                            Background="{DynamicResource Fluent.CardBg}" BorderBrush="{DynamicResource Fluent.CardStroke}">
                        <StackPanel>
                            <DockPanel Margin="16,10,8,10" MinHeight="32">
                                <views:Glyph x:Name="Icon" DockPanel.Dock="Left" Width="20" Height="20" Margin="2,0,16,0" StrokeWeight="1.6" VerticalAlignment="Center"
                                             Kind="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=Info}"
                                             Foreground="{DynamicResource Fluent.Text}" />
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Fluent.IconButton}" Margin="4,0,0,0" VerticalAlignment="Center"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <views:Glyph x:Name="Chevron" Kind="ChevronDown" Width="12" Height="12" StrokeWeight="2.4" RenderTransformOrigin="0.5,0.5">
                                        <views:Glyph.RenderTransform>
                                            <RotateTransform x:Name="Turn" Angle="0" />
                                        </views:Glyph.RenderTransform>
                                    </views:Glyph>
                                </ToggleButton>
                                <ContentPresenter DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding HeaderContent}" />
                                <StackPanel VerticalAlignment="Center">
                                    <ContentPresenter Content="{TemplateBinding Header}" />
                                    <ContentPresenter x:Name="Desc" Content="{TemplateBinding Description}">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="Foreground" Value="{DynamicResource Fluent.TextSecondary}" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </StackPanel>
                            </DockPanel>
                            <Grid x:Name="Body">
                                <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource Fluent.Divider}" />
                                <Border Background="{DynamicResource Fluent.CardBgSecondary}" CornerRadius="0,0,8,8">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NavigationView pane item (RadioButton): icon over label, rounded hover fill, accent pill when selected. -->
    <Style x:Key="Fluent.NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fluent.Text}" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Height" Value="56" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Fluent.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="4" Background="Transparent" />
                        <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource Fluent.Accent}" Visibility="Collapsed" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fluent.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fluent.SubtlePressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fluent.SubtleHover}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caption buttons drawn by the app where Windows does not (Windows 7/8/10): 46 x 32, red close hover. -->
    <Style x:Key="Fluent.CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource Fluent.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fluent.SubtleHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fluent.SubtlePressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Fluent.CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource Fluent.CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFC42B1C" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#E6C42B1C" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
