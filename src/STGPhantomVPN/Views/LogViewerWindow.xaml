<Window x:Class="STGPhantomVPN.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:STGPhantomVPN.Views"
        xmlns:svc="clr-namespace:STGPhantomVPN.Services"
        Title="{Binding [log_viewer_title], Source={x:Static svc:Loc.Instance}}"
        Width="860" Height="580" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.ico"
        Background="{DynamicResource Fluent.WindowBg}"
        Foreground="{DynamicResource Fluent.Text}"
        TextElement.Foreground="{DynamicResource Fluent.Text}"
        TextElement.FontSize="14"
        FontFamily="{StaticResource Fluent.Font}"
        UseLayoutRounding="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0"
                       Text="{Binding [log_viewer_file], Source={x:Static svc:Loc.Instance}}" />
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnRefresh"
                    Content="{Binding [log_refresh], Source={x:Static svc:Loc.Instance}}" />
            <ComboBox x:Name="Files" Style="{StaticResource Fluent.ComboBox}" DisplayMemberPath="Label" SelectionChanged="OnFileChanged" />
        </DockPanel>
        <TextBox x:Name="LogText" Grid.Row="1" Margin="0,12,0,0" Padding="8"
                 IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" FontFamily="Consolas, Courier New" FontSize="12"
                 BorderThickness="1" BorderBrush="{DynamicResource Fluent.CardStroke}"
                 Background="{DynamicResource Fluent.CardBg}" Foreground="{DynamicResource Fluent.Text}"
                 SelectionBrush="{DynamicResource Fluent.Accent}" CaretBrush="{DynamicResource Fluent.Text}" />
        <TextBlock x:Name="Note" Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource Fluent.Caption}" />
        <WrapPanel Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button Click="OnCopy">
                <StackPanel Orientation="Horizontal">
                    <views:Glyph Kind="Copy" Width="16" Height="16" StrokeWeight="1.8" VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding [log_copy], Source={x:Static svc:Loc.Instance}}" />
                </StackPanel>
            </Button>
            <Button Margin="8,0,0,0" Click="OnClear" Foreground="{DynamicResource Fluent.Critical}">
                <StackPanel Orientation="Horizontal">
                    <views:Glyph Kind="Trash" Width="16" Height="16" StrokeWeight="1.8" VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding [log_clear], Source={x:Static svc:Loc.Instance}}" />
                </StackPanel>
            </Button>
            <Button Margin="8,0,0,0" Click="OnOpenFolder"
                    Content="{Binding [log_open_folder], Source={x:Static svc:Loc.Instance}}" />
            <Button Margin="8,0,0,0" Style="{StaticResource Fluent.AccentButton}" MinWidth="96" Click="OnClose" IsCancel="True"
                    Content="{Binding [close_action], Source={x:Static svc:Loc.Instance}}" />
        </WrapPanel>
    </Grid>
</Window>
